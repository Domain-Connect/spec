</bibitem>
<bibitem id="_cf133966-d934-a964-9035-639ea92830b8" type="standard" schema-version="v1.2.9" anchor="RFC3597">
  <fetched>2026-06-05</fetched>
  
<title type="main" format="text/plain">Handling of Unknown DNS Resource Record (RR) Types</title>

  <uri type="src">https://www.rfc-editor.org/info/rfc3597</uri>
  <docidentifier type="IETF" primary="true">RFC 3597</docidentifier>
  <docidentifier type="DOI">10.17487/RFC3597</docidentifier>
  <docnumber>RFC3597</docnumber>
  <date type="published">
    <on>2003-09</on>
  </date>
  <contributor>
    <role type="author"/>
    <person>
      
<name>          <completename language="en" script="Latn">A. Gustafsson</completename>       </name>

    </person>
  </contributor>
  <contributor>
    <role type="publisher"/>
    <organization>
      
<name>RFC Publisher</name>

    </organization>
  </contributor>
  <contributor>
