<title type="main" format="text/plain">JSON Web Algorithms (JWA)</title>

  <uri type="src">https://www.rfc-editor.org/info/rfc7518</uri>
  <docidentifier type="IETF" primary="true">RFC 7518</docidentifier>
  <docidentifier type="DOI">10.17487/RFC7518</docidentifier>
