  <fetched>2026-06-05</fetched>
  
<title type="main" format="text/plain">Internationalized Domain Names for Applications (IDNA): Definitions and Document Framework</title>

  <uri type="src">https://www.rfc-editor.org/info/rfc5890</uri>
  <docidentifier type="IETF" primary="true">RFC 5890</docidentifier>
