<bibdata type="standard">
<title language="en" format="text/plain" type="main">Domain Connect Protocol - DNS provisioning between Services and DNS Providers</title>

<title language="en" format="text/plain" type="abbrev">Domain Connect</title>
<docidentifier primary="true">draft-ietf-dconn-domainconnect-02</docidentifier><docnumber>draft-ietf-dconn-domainconnect-02</docnumber><date type="published"><on>2026-03-01</on></date><contributor><role type="author"/><person>
