  <keyword>Documents</keyword>
</bibitem>
<bibitem id="_13002638-4fc3-8c40-99ef-7a7c227dd24d" type="standard" schema-version="v1.2.9" anchor="RFC8174">
  <fetched>2026-06-05</fetched>
  
<title type="main" format="text/plain">Ambiguity of Uppercase vs Lowercase in RFC 2119 Key Words</title>

  <uri type="src">https://www.rfc-editor.org/info/rfc8174</uri>
  <docidentifier type="IETF" primary="true">RFC 8174</docidentifier>
  <docidentifier type="DOI">10.17487/RFC8174</docidentifier>
  <docnumber>RFC8174</docnumber>
  <date type="published">
    <on>2017-05</on>
  </date>
  <contributor>
    <role type="author"/>
    <person>
      
<name>          <completename language="en" script="Latn">B. Leiba</completename>       </name>

    </person>
  </contributor>
  <contributor>
    <role type="publisher"/>
    <organization>
      
<name>RFC Publisher</name>

    </organization>
  </contributor>
  <contributor>
    <role type="authorizer"/>
    <organization>
      
<name>RFC Series</name>

    </organization>
  </contributor>
  <language>en</language>
  <script>Latn</script>
  <abstract format="text/html" language="en" script="Latn">
    <p id="_e4d5124c-0ac7-e492-e5aa-8e81479d28cf">RFC 2119 specifies common key words that may be used in protocol specifications. This document aims to reduce the ambiguity by clarifying that only UPPERCASE usage of the key words have the defined special meanings.</p>

  </abstract>
